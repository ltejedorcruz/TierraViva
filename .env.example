# ============================================================
# TierraViva – Plantilla de variables de entorno
# Raspberry Pi / Sistema de supervisión
# ============================================================
#
# Instrucciones:
#   1. Copiar este fichero:
#        cp .env.example .env
#   2. Completar .env con los canales y claves reales de ThingSpeak.
#   3. No subir nunca .env al repositorio.
#
# Nota:
#   Las claves de escritura de ThingSpeak pertenecen al firmware de
#   cada estación y no son necesarias para la Raspberry Pi, que solo
#   consulta telemetría y estado.
# ============================================================


# ------------------------------------------------------------
# Estaciones activas
# ------------------------------------------------------------
# Lista de estaciones que leerá el proceso de ingesta.
# Deben existir las variables THINGSPEAK_CHANNEL_<ID> y
# THINGSPEAK_READ_KEY_<ID> para cada estación.
STATIONS=A,B

# Estación mostrada por defecto en el dashboard si no se indica otra.
STATION_ID=A


# ------------------------------------------------------------
# ThingSpeak – Estación A
# ------------------------------------------------------------
THINGSPEAK_CHANNEL_A=<CHANNEL_ID_A>
THINGSPEAK_READ_KEY_A=<READ_KEY_A>


# ------------------------------------------------------------
# ThingSpeak – Estación B
# ------------------------------------------------------------
THINGSPEAK_CHANNEL_B=<CHANNEL_ID_B>
THINGSPEAK_READ_KEY_B=<READ_KEY_B>


# ------------------------------------------------------------
# Ingesta desde ThingSpeak
# ------------------------------------------------------------
# Periodo de consulta de ThingSpeak desde main.py.
POLL_INTERVAL_SECONDS=30

# Timeout máximo de cada petición HTTP a ThingSpeak.
REQUEST_TIMEOUT_SECONDS=12


# ------------------------------------------------------------
# Dashboard / API
# ------------------------------------------------------------
# Umbrales de interpretación visual de la humedad del suelo.
# Se usan para clasificar la lectura normalizada como suelo seco,
# normal o húmedo en la API y el dashboard.
#
# Importante:
#   Estos umbrales NO controlan la bomba. La lógica de riego se
#   ejecuta localmente en el firmware de cada estación.
SOIL_LOW_THRESHOLD=35
SOIL_HIGH_THRESHOLD=45

# Periodo de refresco del dashboard web.
WEB_REFRESH_SECONDS=5

# Tiempo máximo para considerar que una lectura sigue siendo reciente.
DATA_STALE_SECONDS=600

# Dirección y puerto recomendados para servir la API.
# Si tierraviva.sh no se ha modificado para leer estas variables,
# el script utilizará por defecto 0.0.0.0:8000.
API_HOST=0.0.0.0
API_PORT=8000


# ------------------------------------------------------------
# Base de datos y directorios
# ------------------------------------------------------------
# Directorio base de ejecución. Si se deja vacío, se usa la raíz
# del repositorio desde la que se ejecutan los scripts.
# TIERRAVIVA_HOME=/ruta/a/TierraViva


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Valores habituales: DEBUG, INFO, WARNING, ERROR
TIERRAVIVA_LOG_LEVEL=INFO
